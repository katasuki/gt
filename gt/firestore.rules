rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn() &&
        (!exists(/databases/$(database)/documents/userAccess/$(request.auth.uid)) ||
          get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.banned != true);
    }

    function isAdmin() {
      return activeUser() &&
        exists(/databases/$(database)/documents/userRoles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userRoles/$(request.auth.uid)).data.role == 'admin';
    }

    function validTask(data) {
      return data.keys().hasAll([
          'name', 'url', 'platform', 'category', 'ownerUid'
        ]) &&
        data.keys().hasOnly([
          'name', 'url', 'platform', 'category', 'difficulty', 'description',
          'ownerUid', 'createdAt'
        ]) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 70 &&
        data.url is string && data.url.size() <= 2048 &&
        (data.url.matches('^https://.*') || data.url.matches('^http://.*')) &&
        data.platform == 'custom' &&
        data.category in ['clicking', 'tracking', 'switching'] &&
        data.ownerUid == request.auth.uid;
    }

    match /trainingTasks/{taskId} {
      allow read: if activeUser();
      allow write: if false;
    }

    match /userTasks/{taskId} {
      allow read: if activeUser() &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if activeUser() && validTask(request.resource.data);
      allow update: if activeUser() &&
        resource.data.ownerUid == request.auth.uid &&
        validTask(request.resource.data);
      allow delete: if activeUser() &&
        (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /userAccess/{uid} {
      allow read: if activeUser() && request.auth.uid == uid;
      allow write: if false;
    }

    match /userRoles/{uid} {
      allow read: if activeUser() && request.auth.uid == uid;
      allow write: if false;
    }

    match /userRanks/{uid} {
      allow read: if activeUser() && request.auth.uid == uid;
      allow write: if false;
    }

    match /aimProgress/{uid}/runs/{runId} {
      allow read: if activeUser() && request.auth.uid == uid;
      allow create: if activeUser() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasAll([
          'missionId', 'chapterId', 'score', 'hits', 'shots',
          'mode', 'dailyKey', 'dailyComplete', 'accuracy', 'durationSeconds', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'missionId', 'chapterId', 'score', 'hits', 'shots',
          'mode', 'dailyKey', 'dailyComplete', 'accuracy', 'durationSeconds', 'createdAt'
        ]) &&
        request.resource.data.missionId in [
          'flick_basics', 'micro_flick', 'wide_flick', 'precision_pop',
          'tracking_orbit', 'tracking_sweep', 'tracking_strafe',
          'tracking_vertical', 'switching_duo', 'switching_triad',
          'switching_rapid', 'switching_mixed', 'precision_headline',
          'precision_tiny', 'precision_reaction'
        ] &&
        request.resource.data.chapterId in ['flick', 'tracking', 'switching', 'precision'] &&
        request.resource.data.durationSeconds is int &&
        request.resource.data.durationSeconds >= 0 &&
        request.resource.data.durationSeconds <= 45 &&
        ((request.resource.data.missionId in [
            'flick_basics', 'micro_flick', 'wide_flick', 'precision_pop'
          ] && request.resource.data.chapterId == 'flick') ||
          (request.resource.data.missionId in [
            'tracking_orbit', 'tracking_sweep', 'tracking_strafe', 'tracking_vertical'
          ] && request.resource.data.chapterId == 'tracking') ||
          (request.resource.data.missionId in [
            'switching_duo', 'switching_triad', 'switching_rapid', 'switching_mixed'
          ] && request.resource.data.chapterId == 'switching') ||
          (request.resource.data.missionId in [
            'precision_headline', 'precision_tiny', 'precision_reaction'
          ] && request.resource.data.chapterId == 'precision')) &&
        request.resource.data.mode in ['practice', 'daily'] &&
        request.resource.data.dailyKey is string &&
        request.resource.data.dailyComplete is bool &&
        ((request.resource.data.mode == 'daily' &&
            (!request.resource.data.dailyComplete || request.resource.data.durationSeconds >= 30)) ||
          (request.resource.data.mode == 'practice' && request.resource.data.dailyComplete == false)) &&
        ((request.resource.data.mode == 'daily' &&
            request.resource.data.dailyKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')) ||
          (request.resource.data.mode == 'practice' && request.resource.data.dailyKey == '')) &&
        request.resource.data.score is int &&
        request.resource.data.score >= 0 &&
        request.resource.data.score <= 100000 &&
        request.resource.data.hits is int &&
        request.resource.data.hits >= 0 &&
        request.resource.data.shots is int &&
        request.resource.data.shots >= request.resource.data.hits &&
        request.resource.data.shots <= 1000 &&
        request.resource.data.score == request.resource.data.hits * 100 &&
        request.resource.data.accuracy is int &&
        request.resource.data.accuracy >= 0 &&
        request.resource.data.accuracy <= 100 &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /aimProgress/{uid}/settings/{gameId} {
      allow read: if activeUser() && request.auth.uid == uid;
      allow create, update: if activeUser() &&
        request.auth.uid == uid &&
        gameId in [
          'valorant', 'counter-strike-2', 'apex-legends', 'overwatch-2',
          'rainbow-six-siege', 'fortnite', 'call-of-duty',
          'pubg-battlegrounds', 'marvel-rivals'
        ] &&
        request.resource.data.keys().hasAll([
          'gameId', 'gameName', 'sensitivity', 'dpi', 'note', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'gameId', 'gameName', 'sensitivity', 'dpi', 'note', 'updatedAt'
        ]) &&
        request.resource.data.gameId == gameId &&
        request.resource.data.gameName is string &&
        request.resource.data.gameName.size() > 0 &&
        request.resource.data.gameName.size() <= 40 &&
        request.resource.data.sensitivity is number &&
        request.resource.data.sensitivity >= 0.01 &&
        request.resource.data.sensitivity <= 1000 &&
        request.resource.data.dpi is int &&
        request.resource.data.dpi >= 100 &&
        request.resource.data.dpi <= 32000 &&
        request.resource.data.note is string &&
        request.resource.data.note.size() <= 120 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
